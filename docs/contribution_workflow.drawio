        <mxCell id="step1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. Fork &amp; Clone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #cbd5e1;&quot;&gt;git clone repo &amp; setup venv&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
