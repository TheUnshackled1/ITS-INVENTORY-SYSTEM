  <diagram id="pr-flow" name="Pull Request Review Lifecycle">
    <mxGraphModel dx="1200" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pr1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. Push Branch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #bae6fd;&quot;&gt;git push origin feature/...&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="150" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pr2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2. Open Pull Request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #a7f3d0;&quot;&gt;Fill PR Template Checklist&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#092E20;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="80" width="160" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pr3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;3. Automated CI Tests&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #fde047;&quot;&gt;manage.py test &amp; check&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#854d0e;strokeColor=#fde047;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
