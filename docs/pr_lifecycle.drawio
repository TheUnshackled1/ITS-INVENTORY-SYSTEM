        </mxCell>

        <mxCell id="pr4" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;4. Maintainer Review&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #ddd6fe;&quot;&gt;Code Inspection &amp; Approval&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#c084fc;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="160" height="75" as="geometry" />
        </mxCell>

        <mxCell id="pr5" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;5. Merge to Main&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #a7f3d0;&quot;&gt;Merged into main branch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
