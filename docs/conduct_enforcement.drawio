        <mxCell id="st1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;1. Incident Report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #bae6fd;&quot;&gt;Private email to MIS lead&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="150" height="75" as="geometry" />
